# Copy to .env.local and fill in. See docs: README / Phase 2 of the accounts plan.

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Include the database name, e.g. .../photo-relief?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js session-encryption secret. Generate one with:  npx auth secret
AUTH_SECRET=

# Google OAuth client (https://console.cloud.google.com → APIs & Services → Credentials →
# Create credentials → OAuth client ID → Web application).
# Add this Authorized redirect URI:  http://localhost:3000/api/auth/callback/google
# (and your production URL's /api/auth/callback/google when you deploy)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vercel Blob read/write token — stores project images, thumbnails, and saved 3MF exports.
# Create a Blob store at vercel.com (Storage > Blob) and copy its token, or run `vercel env pull`.
# Required for saving/opening projects and export history; without it those uploads fail (the tool
# itself still works). Local dev can use a real token — the SDK talks to Vercel's Blob API.
BLOB_READ_WRITE_TOKEN=
