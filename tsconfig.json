{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "incremental": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Path alias: @/ -> src/ */
    "paths": {
      "@/*": ["./src/*"]
    },
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "proxy.ts",
    "app",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Test files are intentionally included (not excluded): VS Code only auto-discovers
  // `tsconfig.json`, so excluding *.test.* here would orphan those files into an inferred project
  // with no `@/*` paths (unresolved-import errors in the editor). Referencing tsconfig.test.json
  // instead isn't an option — TS requires referenced projects to be `composite` + emit, which the
  // noEmit configs can't be. They cost a little `next build` typecheck time but are never bundled
  // (no route imports them). tsconfig.test.json remains the tuned gate with the test-only types.
  "exclude": ["node_modules", "e2e", "scripts"]
}
