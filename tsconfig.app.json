{
  // Shared base for tsconfig.test.json only (the Next app config is the root tsconfig.json now).
  // Carries the DOM lib + strict flags the specs type-check under; tsconfig.test.json supplies its
  // own `types`, `include`, and tsBuildInfoFile.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
